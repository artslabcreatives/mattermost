{
    "id": "com.artslabcreatives.lms",
    "name": "LMS",
    "description": "LMS application integrated in Mattermost RHS",
    "homepage_url": "https://lms.artslabcreatives.com",
    "support_url": "https://lms.artslabcreatives.com",
    "icon_path": "public/icon.png",
    "min_server_version": "7.0.0",
    "server": {
        "executables": {
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64"
        }
    },
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    },
    "settings_schema": {
        "header": "LMS Access Control Settings",
        "footer": "Control which users can see and access the LMS plugin in the sidebar.",
        "settings": [
            {
                "key": "AllowAllUsers",
                "display_name": "Allow All Users:",
                "type": "bool",
                "help_text": "When enabled, all active users can see and access LMS in the sidebar.",
                "default": true
            },
            {
                "key": "AllowedUserIDs",
                "display_name": "Allowed Users (Usernames or User IDs):",
                "type": "text",
                "help_text": "Comma-separated list of usernames (e.g. john, mary) or user IDs allowed to see LMS when 'Allow All Users' is disabled.",
                "placeholder": "john, mary, santosh",
                "default": ""
            }
        ]
    }
}
